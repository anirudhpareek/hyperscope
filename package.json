{
  "name": "hyperscope",
  "version": "1.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite build --watch",
    "build": "tsc && vite build",
    "typecheck": "tsc --noEmit",
    "package": "npm run build && cd dist && zip -r ../hyperscope-v$npm_package_version.zip . -x '*.DS_Store'",
    "publish:chrome": "chrome-webstore-upload upload --source hyperscope-v$npm_package_version.zip --auto-publish"
  },
  "dependencies": {
    "preact": "^10.19.3"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.8.1",
    "@types/chrome": "^0.0.260",
    "chrome-webstore-upload-cli": "^3.5.0",
    "typescript": "^5.3.3",
    "vite": "^5.0.12"
  }
}
